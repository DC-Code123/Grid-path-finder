		t-movement(SP_1,SP_2,PP)
	ELSE IF tag = "+ROW" THEN
		SP_1=(row+1,col+1)
		SP_2=(row-1,col+1)
		t-movement(SP_1,SP_2,PP)
	ELSE IF tag = "-ROW" THEN
		SP_1=(row-1,col-1)
		SP_2=(row+1,col-1)
		t-movement(SP_1,SP_2,PP)
	ELSE IF tag = "+R.DIAG" THEN
		SP_1=(row,col+1)
		SP_2=(row-1,col)
		t-movement(SP_1,SP_2,PP)
	ELSE IF tag = "-R.DIAG" THEN
		SP_1=(row+,col)
